# Repository roots
export MRB_PROJECT_ROOT=/root/rivermind-data/projects/merge-route-boundary
export MRB_ROOT=$MRB_PROJECT_ROOT

# Large files should live outside git.
export MRB_DATA_ROOT=/root/rivermind-data/datasets
export MRB_PROJECT_DATA=/root/rivermind-data/projects/merge-route-boundary/data
export MRB_MODEL_ROOT=/root/rivermind-data/models
export MRB_CACHE_ROOT=/root/rivermind-data/datasets/_cache
export MRB_OUTPUT_ROOT=/root/rivermind-data/outputs
export MRB_FEATURE_ROOT=/root/rivermind-data/datasets/_derived/merge-route-boundary/features

# Hugging Face / Torch cache
export HF_HOME=$MRB_CACHE_ROOT/huggingface
export HF_HUB_CACHE=$HF_HOME/hub
export HF_DATASETS_CACHE=$HF_HOME/datasets
export TRANSFORMERS_CACHE=$HF_HUB_CACHE
export TORCH_HOME=$MRB_CACHE_ROOT/torch

# Optional: set only if private Hugging Face resources are needed later.
# export HF_TOKEN=...
